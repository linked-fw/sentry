@prefix sentry: <https://linked.cm/ont/sentry/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .

sentry:
    a owl:Ontology ;
    dcterms:description "Terms of the Sentry error-reporting package."@en ;
    dcterms:title "Linked Sentry"@en ;
    owl:versionInfo "1.3.0" .

sentry:ExampleClass
    a owl:Class ;
    rdfs:comment "A placeholder class left from the package template; nothing uses it."@en ;
    rdfs:label "Example class"@en .

sentry:exampleProperty
    a owl:DatatypeProperty ;
    rdfs:comment "A placeholder property left from the package template; nothing uses it."@en ;
    rdfs:label "example property"@en .
