    "@sentry/capacitor": "1.5.0",
    "@sentry/node": "8.55.0",
    "@sentry/profiling-node": "8.55.0",
    "@sentry/react": "8.55.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.45.5",
